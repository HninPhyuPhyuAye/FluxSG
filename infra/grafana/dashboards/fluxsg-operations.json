      "targets": [{"expr": "sum by (route, status) (rate(fluxsg_http_requests_total[5m]))", "legendFormat": "{{route}} · {{status}}", "refId": "A"}],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
