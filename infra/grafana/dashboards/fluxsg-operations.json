      "targets": [{"expr": "fluxsg:ingestion_freshness:max_seconds", "refId": "A"}],
      "title": "Maximum ingestion age · objective <30 min",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
