# Optional browser-facing API URL. If omitted, the public dashboard reads the
# official data.gov.sg endpoints directly.
NEXT_PUBLIC_FLUXSG_API_URL=http://localhost:8000

# LTA DataMall requires a free account key. Never commit the real value.
LTA_ACCOUNT_KEY=
LTA_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice
LTA_CACHE_TTL_SECONDS=21600

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Local reproducible-ingestion stack. Change these values outside local use.
POSTGRES_DB=fluxsg
POSTGRES_USER=fluxsg
POSTGRES_PASSWORD=fluxsg-local
DATABASE_URL=postgresql://fluxsg:fluxsg-local@postgres:5432/fluxsg
OBJECT_STORE_ENDPOINT=http://object-store:8333
OBJECT_STORE_ACCESS_KEY=fluxsg
OBJECT_STORE_SECRET_KEY=fluxsg-local-secret
OBJECT_STORE_BUCKET=fluxsg-raw
OBJECT_STORE_SECURE=false
INGESTION_INTERVAL_SECONDS=900
INGESTION_MAX_ATTEMPTS=3

