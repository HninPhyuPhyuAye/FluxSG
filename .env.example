# Optional browser-facing API URL. If omitted, the public dashboard reads the
# official data.gov.sg endpoints directly.
NEXT_PUBLIC_FLUXSG_API_URL=http://localhost:8000

# LTA DataMall requires a free account key. Never commit the real value.
LTA_ACCOUNT_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

